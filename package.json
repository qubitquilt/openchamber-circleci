{
  "name": "openchamber-circleci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenChamber extension for CircleCI: rail panel, attach picker, chat chips and a full-screen runs page.",
  "scripts": {
    "build": "npm run build:panel && npm run build:page && npm run build:attach && npm run build:background",
    "build:panel": "esbuild src/panel/main.ts --bundle --format=iife --platform=browser --target=es2022 --minify --legal-comments=none --outfile=panel/main.js",
    "build:page": "esbuild src/page/main.ts --bundle --format=iife --platform=browser --target=es2022 --minify --legal-comments=none --outfile=panel/page.js",
    "build:attach": "esbuild src/attach/main.ts --bundle --format=iife --platform=browser --target=es2022 --minify --legal-comments=none --outfile=panel/attach.js",
    "build:background": "esbuild src/background/main.ts --bundle --format=iife --platform=browser --target=es2022 --minify --legal-comments=none --outfile=background/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts eslint.config.mjs",
    "lint:fix": "eslint src test scripts eslint.config.mjs --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"panel/*.html\" \"background/*.html\" package.json tsconfig.json eslint.config.mjs README.md AGENTS.md",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"panel/*.html\" \"background/*.html\" package.json tsconfig.json eslint.config.mjs README.md AGENTS.md",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "npm run build && npm run build:test && node --test test/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:manifest && npm run build && npm test",
    "clean": "node -e \"for (const f of ['panel/main.js','panel/page.js','panel/attach.js','background/main.js']) require('node:fs').rmSync(f,{force:true}); require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build:test": "esbuild src/shared/format.ts src/shared/client.ts src/shared/slug.ts src/shared/storage.ts --bundle --format=esm --platform=neutral --target=es2022 --outdir=build --out-extension:.js=.mjs"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.3.0"
    },
    "contributes": {
      "panel": {
        "id": "circleci",
        "name": "CircleCI",
        "icon": "assets/circleci.svg",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/page.html",
        "title": "CircleCI Runs"
      },
      "attach": {
        "mode": "dialog",
        "entry": "panel/attach.html"
      },
      "background": {
        "entry": "background/index.html"
      },
      "capabilities": [
        "prompt",
        "sessions",
        "files"
      ],
      "integration": {
        "name": "CircleCI",
        "description": "Runs, workflows and jobs from your CircleCI projects",
        "token": {
          "apiOrigin": "https://circleci.com",
          "scheme": "bearer"
        }
      },
      "actions": [
        {
          "id": "check-ci-status",
          "label": "Check CircleCI status",
          "icon": "assets/circleci.svg",
          "where": "session",
          "mode": "background"
        }
      ],
      "commands": [
        {
          "name": "circleci",
          "description": "Attach a CircleCI run by number, for example 123"
        }
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
